[task parameters]
        F = 0..168..3
        site = 0..424..1

[scheduler]
    allow implicit tasks = True
[scheduling]
    initial cycle point = 20251001T00Z
    [[graph]]
        T00 = """
            preprocess<F> => gather_preprocess
            gather_preprocess => site_preprocess<site>
            site_preprocess<site> => plot<site>
        """

[runtime]
    [[root]]
        execution time limit = PT2H
        work sub-directory = work

    [[preprocess]]
        script = "./bin/preprocess.bash ${CYLC_TASK_PARAM_F}"
        

    [[gather_preprocess]]
        script = "touch gathered.flag"

    [[site_preprocess]]
        script = "./bin/site_preprocess.bash ${CYLC_TASK_PARAM_SITE}"            

    [[plot]]
        script = "./bin/plot.bash ${CYLC_TASK_PARAM_SITE}"