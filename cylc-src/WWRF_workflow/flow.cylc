[task parameters]
    MODEL = WWRF_gfs, WWRF_ecmwf
    F = 0..168..3
    SITE = 0..523..1

[scheduler]
    allow implicit tasks = True

[scheduling]
    initial cycle point = 20251001T00Z

    [[graph]]
        R1 = """
            preprocess<MODEL,F> => gather_preprocess<MODEL>
            gather_preprocess<MODEL> => site_preprocess<MODEL,SITE>
            site_preprocess<MODEL,SITE> => plot<MODEL,SITE>
        """

[runtime]
    [[root]]
        execution time limit = PT2H

    [[preprocess<MODEL,F>]]
        platform = slurm_platform

        script = """
            module load singularitypro

            singularity exec \
                --bind /cw3e:/cw3e \
                /cw3e/mead/projects/cwp186/repos/wvflux_meteograms/envs/wvflux_meteograms.sif \
                /cw3e/mead/projects/cwp186/repos/wvflux_meteograms/cylc-src/WWRF_workflow/bin/preprocess.py \
                --model ${CYLC_TASK_PARAM_MODEL} \
                --leadtime ${CYLC_TASK_PARAM_F} \
                --init_date ${CYLC_TASK_CYCLE_POINT}
        """
    
        [[[directives]]]
            --account = cwp186
            --partition = shared-128
            --time = 01:00:00
            --cpus-per-task = 4
            --mem = 8G

    [[gather_preprocess<MODEL>]]
        script = "echo all ${CYLC_TASK_PARAM_MODEL} lead times processed"

    [[site_preprocess<MODEL,SITE>]]
        platform = slurm_platform

        script = """
            module load singularitypro

            singularity exec \
                --bind /cw3e:/cw3e \
                /cw3e/mead/projects/cwp186/repos/wvflux_meteograms/envs/wvflux_meteograms.sif \
                /cw3e/mead/projects/cwp186/repos/wvflux_meteograms/cylc-src/WWRF_workflow/bin/extract_site.py \
                --model ${CYLC_TASK_PARAM_MODEL} \
                --site ${CYLC_TASK_PARAM_SITE} \
                --init_date ${CYLC_TASK_CYCLE_POINT}
        """
    
        [[[directives]]]
            --account = cwp186
            --partition = shared-128
            --time = 01:00:00
            --cpus-per-task = 4
            --mem = 8G

    [[plot<MODEL,SITE>]]
        platform = slurm_platform

        script = """
            module load singularitypro

            singularity exec \
                --bind /cw3e:/cw3e \
                /cw3e/mead/projects/cwp186/repos/wvflux_meteograms/envs/wvflux_meteograms.sif \
                /cw3e/mead/projects/cwp186/repos/wvflux_meteograms/cylc-src/WWRF_workflow/bin/plot.py \
                --model ${CYLC_TASK_PARAM_MODEL} \
                --site ${CYLC_TASK_PARAM_SITE} \
        """
    
        [[[directives]]]
            --account = cwp186
            --partition = shared-128
            --time = 01:00:00
            --cpus-per-task = 4
            --mem = 8G